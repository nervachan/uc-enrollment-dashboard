# Copy to .env and edit. Used by the loader (python -m app.etl) only — the dashboard
# itself reads from Supabase and needs nothing from this file.

# Supabase: Connect -> Session pooler, with ?sslmode=require. Keep it out of git; it
# holds the database password.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Simplification tolerance in degrees for the stored GeoJSON geometry. 0.005 is about
# 500 m at Cordillera latitudes — invisible on a national choropleth.
GEOJSON_TOLERANCE=0.005
