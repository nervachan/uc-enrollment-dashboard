# Copy to .env and edit. Nothing here has a safe default for production.

DATABASE_URL=postgresql://uc:ucdash@localhost:5432/uc_enrollment

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Guards POST /api/ingest. Leave blank to disable uploads entirely (the endpoints
# return 503), which is the right setting until the upload screen has real auth.
INGEST_API_KEY=

# Simplification tolerance in degrees for /api/geo responses. 0.005 is about 500 m
# at Cordillera latitudes — invisible on a national choropleth.
GEOJSON_TOLERANCE=0.005

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=128
