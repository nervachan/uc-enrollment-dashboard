# Supabase project settings, from the dashboard: Project Settings -> API (or "Connect").
# Both are public by design: the publishable key can only call the dashboard's read
# functions, never read or write a table. Read at BUILD time — changing them on Vercel
# needs a redeploy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
